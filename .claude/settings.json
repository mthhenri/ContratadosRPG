{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/agentes/codex-delegar.sh:*)",
      "Bash(./scripts/agentes/codex-delegar.sh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agentes/hook-profundidade.sh"
          }
        ]
      }
    ]
  }
}
