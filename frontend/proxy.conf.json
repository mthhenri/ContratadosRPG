{
  "/health": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  "/autenticacao": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  "/campanha": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  // Regex (não prefixo simples) — m3-28 criou a rota de app "/fichas" (plural), que um contexto
  // de string simples "/ficha" prefix-matcharia por engano (Vite: doesProxyContextMatchUrl faz
  // url.startsWith(context) para chaves sem "^"). O boundary [/?] cobre "/ficha/:id..." e
  // "/ficha?campanhaId=..." sem capturar "/fichas".
  "^/ficha(?:$|[/?])": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  "/usuario": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  "/socket.io": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true,
    "ws": true
  }
}
