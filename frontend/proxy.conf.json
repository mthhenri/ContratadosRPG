{
  "/health": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  "/autenticacao": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  // Regex (não prefixo simples) — mesma colisão do /ficha acima: rota de app
  // "/campanhas" (plural) é prefixo-matchada por engano pela API "/campanha"
  // (singular) em contextos de string simples (Vite: doesProxyContextMatchUrl
  // faz url.startsWith(context)). O boundary [/?] cobre "/campanha/:id..." e
  // "/campanha?..." sem capturar "/campanhas".
  "^/campanha(?:$|[/?])": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  "/pagina-caderno": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  // Regex (não prefixo simples) — m3-28 criou a rota de app "/fichas" (plural), que um contexto
  // de string simples "/ficha" prefix-matcharia por engano (Vite: doesProxyContextMatchUrl faz
  // url.startsWith(context) para chaves sem "^"). O boundary [/?] cobre "/ficha/:id..." e
  // "/ficha?campanhaId=..." sem capturar "/fichas".
  "^/ficha(?:$|[/?])": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  // Exclusão de rolagem por ADMIN (I-033): `DELETE /rolagem/:id`. Sem `/rolagem` aqui o dev server
  // não a encaminha ao backend. Prefixo simples — não há rota de app "/rolagens".
  "/rolagem": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  "/encontro": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  // Cena (m7-22/m7-23): `GET /cena/:id`, `POST /cena/:id/abrir|encerrar`. Regex com o mesmo
  // boundary de /ficha e /campanha — a rota de app das cenas é "/campanhas/:id/cenas", mas o
  // boundary deixa explícito que só a API singular é encaminhada.
  "^/cena(?:$|[/?])": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  // Documento de campanha (m9-02): `GET/PUT/DELETE /documento/:id`, `POST /documento/:id/revelar|
  // ocultar|imagem`. Regex com o mesmo boundary de /ficha e /cena — a rota de app da biblioteca é
  // "/campanhas/:id/documentos" (plural), e o boundary impede que um "/documentos" seja encaminhado
  // à API por prefixo (Vite: doesProxyContextMatchUrl faz url.startsWith(context)).
  "^/documento(?:$|[/?])": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  "/usuario": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  "/uploads": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  "/socket.io": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true,
    "ws": true
  }
}
