{
  "/health": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  "/autenticacao": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  // Regex (não prefixo simples) — mesma colisão do /ficha acima: rota de app
  // "/campanhas" (plural) é prefixo-matchada por engano pela API "/campanha"
  // (singular) em contextos de string simples (Vite: doesProxyContextMatchUrl
  // faz url.startsWith(context)). O boundary [/?] cobre "/campanha/:id..." e
  // "/campanha?..." sem capturar "/campanhas".
  "^/campanha(?:$|[/?])": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  "/pagina-caderno": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  // Regex (não prefixo simples) — m3-28 criou a rota de app "/fichas" (plural), que um contexto
  // de string simples "/ficha" prefix-matcharia por engano (Vite: doesProxyContextMatchUrl faz
  // url.startsWith(context) para chaves sem "^"). O boundary [/?] cobre "/ficha/:id..." e
  // "/ficha?campanhaId=..." sem capturar "/fichas".
  "^/ficha(?:$|[/?])": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  "/encontro": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  "/usuario": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  "/uploads": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true
  },
  "/socket.io": {
    "target": "http://localhost:3100",
    "secure": false,
    "changeOrigin": true,
    "ws": true
  }
}
