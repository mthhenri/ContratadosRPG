{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/preparar-documentos.mjs && node scripts/preparar-pdf-worker.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/preparar-documentos.mjs && node scripts/preparar-pdf-worker.mjs",
    "build": "ng build && node -e \"require('fs').copyFileSync('dist/frontend/browser/index.html','dist/frontend/browser/404.html')\" && node scripts/verificar-documentos-publicados.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@contratados-rpg/shared": "*",
    "@milkdown/kit": "^7.22.1",
    "@milkdown/plugin-collab": "^7.22.1",
    "@primeuix/themes": "^1.1.1",
    "marked": "^18.0.9",
    "pdfjs-dist": "^4.10.38",
    "primeng": "^21.1.9",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.3.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@angular/build": "^21.2.18",
    "@angular/cli": "^21.2.18",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^9.18.0",
    "angular-eslint": "^21.0.0",
    "eslint": "^9.18.0",
    "jsdom": "^28.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.0.8"
  }
}
